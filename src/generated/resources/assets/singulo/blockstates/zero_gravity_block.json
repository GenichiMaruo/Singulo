{
  "multipart": [
    {
      "when": {
        "powered": "false"
      },
      "apply": {
        "model": "singulo:block/zero_gravity_block_base"
      }
    },
    {
      "when": {
        "powered": "true"
      },
      "apply": {
        "model": "singulo:block/zero_gravity_block_base_on"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "singulo:block/zero_gravity_block_edge_north"
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "singulo:block/zero_gravity_block_edge_south"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "singulo:block/zero_gravity_block_edge_east"
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "singulo:block/zero_gravity_block_edge_west"
      }
    },
    {
      "when": {
        "up": "false"
      },
      "apply": {
        "model": "singulo:block/zero_gravity_block_edge_up"
      }
    },
    {
      "when": {
        "down": "false"
      },
      "apply": {
        "model": "singulo:block/zero_gravity_block_edge_down"
      }
    }
  ]
}
