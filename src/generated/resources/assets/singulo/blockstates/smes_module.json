{
  "multipart": [
    {
      "when": {
        "facing": "north",
        "lit": "false"
      },
      "apply": {
        "model": "singulo:block/smes_module"
      }
    },
    {
      "when": {
        "facing": "north",
        "lit": "true"
      },
      "apply": {
        "model": "singulo:block/smes_module_on"
      }
    },
    {
      "when": {
        "facing": "east",
        "lit": "false"
      },
      "apply": {
        "model": "singulo:block/smes_module",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "lit": "true"
      },
      "apply": {
        "model": "singulo:block/smes_module_on",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "lit": "false"
      },
      "apply": {
        "model": "singulo:block/smes_module",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "lit": "true"
      },
      "apply": {
        "model": "singulo:block/smes_module_on",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "lit": "false"
      },
      "apply": {
        "model": "singulo:block/smes_module",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "lit": "true"
      },
      "apply": {
        "model": "singulo:block/smes_module_on",
        "y": 270
      }
    },
    {
      "when": {
        "boosted": "true"
      },
      "apply": {
        "model": "singulo:block/boost_overlay"
      }
    }
  ]
}
