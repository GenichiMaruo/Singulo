{
  "multipart": [
    {
      "when": {
        "straight": "none"
      },
      "apply": {
        "model": "singulo:block/copper_wire_core"
      }
    },
    {
      "when": {
        "straight": "z"
      },
      "apply": {
        "model": "singulo:block/copper_wire_straight"
      }
    },
    {
      "when": {
        "straight": "x"
      },
      "apply": {
        "model": "singulo:block/copper_wire_straight",
        "y": 90
      }
    },
    {
      "when": {
        "straight": "y"
      },
      "apply": {
        "model": "singulo:block/copper_wire_straight",
        "x": 90
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "singulo:block/copper_wire_arm"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "singulo:block/copper_wire_arm",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "singulo:block/copper_wire_arm",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "singulo:block/copper_wire_arm",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "singulo:block/copper_wire_arm",
        "x": 270
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "singulo:block/copper_wire_arm",
        "x": 90
      }
    }
  ]
}
